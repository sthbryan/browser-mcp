{
  "name": "@sthbryan/browser-mcp",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/sthbryan/browser-mcp"
  },
  "homepage": "https://github.com/sthbryan/browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/sthbryan/browser-mcp/issues"
  },
  "author": {
    "name": "sthbryan",
    "url": "https://justcallmebryan.com"
  },
  "description": "MCP server for browser automation via Puppeteer stealth — system Chrome/Brave/Edge, screenshots, fetch_page, query, search",
  "main": "./dist/index.js",
  "bin": {
    "browser-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external puppeteer-core --external puppeteer-extra --external puppeteer-extra-plugin-stealth --external @puppeteer/browsers",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check --diagnostic-level=error .",
    "smoke": "bun run scripts/smoke-test.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build",
    "release": "bun run scripts/release.ts",
    "postinstall": "[ -d .git ] && lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "lefthook": "2.1.10"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@puppeteer/browsers": "^3.0.6",
    "node-html-parser": "^9.0.0",
    "puppeteer-core": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "turndown": "^7.2.4",
    "zod": "4.4.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "screenshot",
    "puppeteer",
    "stealth",
    "web-search",
    "duckduckgo"
  ],
  "license": "MIT"
}
